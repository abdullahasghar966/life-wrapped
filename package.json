{
  "name": "life-wrapped",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-duckdb.mjs",
    "dev": "node scripts/copy-duckdb.mjs && next dev",
    "build": "node scripts/copy-duckdb.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit && vitest run tests/perf --no-file-parallelism",
    "test:watch": "vitest",
    "lighthouse": "node scripts/lighthouse.mjs",
    "demo:gif": "node scripts/record-demo.mjs",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:unit": "vitest run tests/unit",
    "test:perf": "vitest run tests/perf --no-file-parallelism"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.1.0",
    "@streamparser/json": "^0.0.26",
    "apache-arrow": "^17.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "comlink": "^4.4.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.49.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.9"
  }
}
