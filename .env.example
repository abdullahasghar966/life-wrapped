# Optional. Only needed for the "Share link" feature (POST /api/share).
# Without it the app works fully and share buttons explain that sharing isn't configured.
# Neon Postgres connection string, e.g. postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Random secret used to hash IP addresses for rate limiting. Raw IPs are never stored.
# Generate one with: node -e "console.log(crypto.randomUUID())"
SHARE_SALT=
